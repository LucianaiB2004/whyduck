# Node.js 24+. Copy to .env locally; never commit real secrets.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_ORIGIN=http://127.0.0.1:5173

# Leave empty for clearly labelled prepared demonstration cases.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-max
AI_TIMEOUT_MS=60000

# Only identity linking is implemented; not order/bill access or refunds.
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# All MCP requests need an account-issued Bearer token.
MCP_ENABLED=true

# Optional remote persistence; required for EdgeOne. Leave blank for local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
EVIDENCE_STORAGE=local
EVIDENCE_BLOB_STORE=whyduck-evidence
EVIDENCE_ENCRYPTION_KEY=
