# Prepared only. Do not activate until public-release requirements are verified.
server {
    listen 80;
    server_name 43.136.97.223;
    location /.well-known/acme-challenge/ { root /srv/whyduck/acme; }
    location / { return 301 https://43.136.97.223$request_uri; }
}
server {
    listen 443 ssl;
    server_name 43.136.97.223;
    ssl_certificate /etc/letsencrypt/live/43.136.97.223/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/43.136.97.223/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 12m;
    location / {
        proxy_pass http://127.0.0.1:4301;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 360s;
    }
}
