page{background:#FFFDF6;color:#322B22;font-family:system-ui} .page{padding:24rpx}.title{font-size:42rpx;font-weight:bold}.hint{color:#74674F;font-size:26rpx;line-height:1.6}.card{background:white;border:1px solid #E9DFCA;border-radius:24rpx;padding:24rpx;margin:20rpx 0}.row{display:flex;flex-wrap:wrap;gap:12rpx}button{background:#FFD65A;border-radius:20rpx;margin:12rpx 0;font-size:28rpx}input,textarea{background:white;border:1px solid #D9CEB8;border-radius:12rpx;padding:16rpx;margin:16rpx 0;box-sizing:border-box;width:100%}.error{color:#AE342F}.badge{color:#934320}.duck{width:96rpx;height:96rpx}.quote{padding:14rpx;background:#FFF6D9;white-space:pre-wrap;word-break:break-all}
