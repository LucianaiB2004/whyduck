<view class="page"><view class="title">我的案件</view><view class="error">{{error}}</view><view class="hint" a:if="{{!cases.length}}">还没有案件，去事务所描述遇到的事。</view><view class="card" a:for="{{cases}}" key="id" data-id="{{item.id}}" onTap="open"><view>{{item.title}}</view><view class="badge" a:if="{{item.demo}}">模拟示例</view><view class="hint">{{item.status}} · {{item.updatedAt}}</view></view></view>
