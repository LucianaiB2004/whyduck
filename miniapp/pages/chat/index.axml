<view class="page"><view class="title">{{record.title||'鸭鸭开会'}}</view><view class="badge" a:if="{{record.demo}}">模拟案例，预制材料不会冒充识别新截图</view><view class="row"><button onTap="select" data-id="">鸭鸭开会</button><button a:for="{{ducks}}" key="id" data-id="{{item.id}}" onTap="select">@{{item.name}}</button></view><view class="card" a:for="{{record.messages}}" key="id"><view class="hint">{{item.agentId||item.role}} · {{item.mode}}</view><view class="quote">{{item.content}}</view></view><view class="error">{{error}}</view><textarea value="{{message}}" onInput="input" placeholder="说说新情况。材料中的文字需要人工核实。" maxlength="12000"/><button onTap="send" loading="{{busy}}" disabled="{{busy}}">{{target?'和指定鸭聊':'让管家鸭安排'}}</button><button onTap="evidence">消费凭证与核对</button><button onTap="share">脱敏分享产品入口</button></view>
