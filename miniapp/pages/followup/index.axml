<view class="page"><view class="title">后手鸭办事单</view><view class="error">{{error}}</view><view class="hint" a:if="{{!items.length}}">还没有待办。</view><view class="card" a:for="{{items}}" key="id"><view>{{item.title}}</view><view class="hint">{{item.caseTitle}} · {{item.status}} · {{item.dueAt||'未定日期'}}</view><button a:if="{{item.status!=='done'}}" data-case="{{item.caseId}}" data-id="{{item.id}}" onTap="done">标记已完成</button></view></view>
